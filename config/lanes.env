# Harness configuration (non-secret, PROJECT-AGNOSTIC — safe to commit).
# Machine-local values (active profile, app-repo paths, DB prefix, …) belong in
# config/local.env (untracked), which bin/_common.sh sources BEFORE this file.
# Both files only fill values not already set, so exporting a var before
# invoking a harness script overrides everything.

HARNESS_ROOT="${HARNESS_ROOT:-$(pwd)}"                  # resolved by bin/_common.sh from its own location
LANES_ROOT="${LANES_ROOT:-$(dirname "$HARNESS_ROOT")}"  # lane clones: $LANES_ROOT/laneN
SOURCE_REPO="${SOURCE_REPO:-}"                          # local app repo lanes clone from (set in config/local.env)
ORIGIN_URL="${ORIGIN_URL:-}"                            # GitHub remote for lane clones; empty -> derived from SOURCE_REPO's origin in lane-bootstrap
PROFILE="${PROFILE:-_template}"                         # active profile: profiles/<PROFILE>/ (stack hooks + config)

# Shared services (one set for all lanes)
PG_HOST="${PG_HOST:-127.0.0.1}"
PG_PORT="${PG_PORT:-5433}"
PG_USER="${PG_USER:-postgres}"
PG_PASS="${PG_PASS:-postgres}"
REDIS_HOST="${REDIS_HOST:-127.0.0.1}"
REDIS_PORT="${REDIS_PORT:-6379}"

# Per-lane derivations
DB_PREFIX="${DB_PREFIX:-app_l}"                         # -> app_l1
API_BASE_PORT="${API_BASE_PORT:-8000}"                  # lane N -> 8000+N
FE_BASE_PORT="${FE_BASE_PORT:-3000}"                    # lane N -> 3000+N
WORKER_QUEUES="${WORKER_QUEUES:-default}"               # queues the worker consumes (app-specific lists go in config/local.env)

COMPOSE_FILE="${COMPOSE_FILE:-$SOURCE_REPO/docker-compose.yml}"

# Secrets (real values live in config/secrets.env, gitignored)
if [ -f "$HARNESS_ROOT/config/secrets.env" ]; then
  # shellcheck disable=SC1091
  source "$HARNESS_ROOT/config/secrets.env"
fi
SEED_USER_PASSWORD="${SEED_USER_PASSWORD:-changeme}"
SEED_USER_EMAIL="${SEED_USER_EMAIL:-admin@example.com}"

# OpenHands DEV engine (dashboard: AI & Chi phí → "DEV — viết code" = OpenHands · <model>).
# The model comes from that setting via the LiteLLM gateway (provider "anthropic" for Claude);
# the toolchain image is the profile's OPENHANDS_BASE_IMAGE. See bin/openhands-step.sh.
OPENHANDS_MAX_PARALLEL="${OPENHANDS_MAX_PARALLEL:-3}"      # sandboxes coding at once, across lanes
OPENHANDS_CPUS="${OPENHANDS_CPUS:-4}"                      # per sandbox
OPENHANDS_MEMORY="${OPENHANDS_MEMORY:-8g}"                 # per sandbox
OPENHANDS_MAX_ITERATIONS="${OPENHANDS_MAX_ITERATIONS:-120}"
OPENHANDS_TIMEOUT="${OPENHANDS_TIMEOUT:-5400}"             # seconds
# Parallel features: how many lanes may build / run e2e at the same time (bin/with-lock.sh).
# Raise to 2-3 on a machine with RAM to spare; 1 = strictly one at a time.
LOCK_SLOTS_BUILD="${LOCK_SLOTS_BUILD:-1}"
LOCK_SLOTS_E2E="${LOCK_SLOTS_E2E:-1}"
