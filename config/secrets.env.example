# Copy to config/secrets.env (gitignored) and fill in.
# Seed account used by lane-bootstrap — created in each lane DB by the profile's
# seed hook; also the qc-local login.
export SEED_USER_PASSWORD='change-me'
export SEED_USER_EMAIL='admin@example.com'

# Dev-site QA password, shared by the per-lane QA accounts. lane-bootstrap writes
# each lane's <lane>/.harness-qa.env (git-excluded) with DEV_QC_EMAIL + this
# password; the dev-qc agent reads that file to (re-)login when the qa-dev
# Chromium profile session expires (~7 days).
export DEV_QC_PASSWORD='change-me'

# Optional per-lane dev-QC email template. {N} → the lane number; lane-qa-creds.sh
# uses it to default DEV_QC_EMAIL when none is passed (e.g. qa-lane{N}@example.com).
# Leave unset/empty to require the email be entered per lane.
export DEV_QC_EMAIL_PATTERN=''

# Tracker login — used by the harness ticketer agent (TRACKER_URL from your
# profile's integrations.env).
export TRACKER_EMAIL='you@example.com'
export TRACKER_PASSWORD='change-me'

# Optional: absolute path to the dataset dir the browser-QC agents (qc-local /
# dev-qc) use for any file-upload scenario. Injected into those agents the same
# way credentials are. Leave empty to skip upload scenarios. Quote if it has
# spaces (e.g. '/path/to/upload fixtures').
export QC_UPLOAD_FIXTURES_DIR=''

# Optional: CircleCI PERSONAL API token (User Settings → Personal API Tokens;
# project tokens can't re-run workflows). Enables bin/ci-job.sh so lane agents
# triage red CI themselves — read failing tests, re-run a flaky workflow from
# failed, cancel a hung one — instead of empty-commit re-triggers or pasting
# logs by hand. Leave empty to disable (lanes fall back to gh-status checks).
export CIRCLE_CI_TOKEN=''

# Dashboard login (Shipyard Platform). The dashboard requires a platform account:
# it logs in through the api-gateway and verifies the JWT with the SAME secret the
# platform services use (their JWT_SECRET env). Leave JWT_SECRET unset only for local
# dev (falls back to the platform's dev default). DASHBOARD_AUTH=off disables login.
export PLATFORM_GATEWAY_URL='http://127.0.0.1:9080'
export JWT_SECRET=''
export DASHBOARD_AUTH='on'

# Shared secret between the harness and platform services for /internal/** APIs
# (orchestrator, project-service, context-service). Same value everywhere.
# Leave empty: bin/platform.sh then generates one per machine in run/platform/service-token.
export SHIPYARD_SERVICE_TOKEN=''

# OpenHands Execution Plane credentials (optional if using host OPENAI_API_KEY)
export OPENHANDS_API_KEY=''
export OPENHANDS_BASE_URL=''
