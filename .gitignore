# runtime artefacts — never committed
/state/
/run/
/logs/
/locks/
# superpowers working docs (specs/plans) — local reference only, never committed
/docs/superpowers/
# real secrets (template is tracked) + machine-local topology
/config/secrets.env
/config/local.env
/config/providers.json
/config/models.json
/config/leak-terms.txt
# per-project profiles are local to each install; only the template ships
/profiles/*
!/profiles/_template/
# internal reports + real-app screenshots stay local
/docs/reports/
/docs/screenshots/*.png
.DS_Store
# dashboard
/dashboard/node_modules/
