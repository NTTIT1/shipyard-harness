# profiles/<your-project>/profile.env — your stack shape (sourced by bin/_common.sh).
# Fill these for your app; each overrides the harness default shown in [brackets].
# The /harness-adapt skill can infer most of these from your repo.

DB_URL_SCHEME="postgresql+asyncpg"          # driver scheme in DATABASE_URL          [postgresql+asyncpg]
API_PATH="/api/v1"                          # API mount path; health hits <API_PATH>/... [/api/v1]
UPLOAD_SUBDIR="backend/data/uploads"        # per-lane upload dir, relative to the clone [backend/data/uploads]
BACKEND_DIR="backend"                       # backend subdir in your repo               [backend]
FRONTEND_DIR="frontend"                     # frontend subdir in your repo              [frontend]
DB_SERVICE="postgres"                       # docker-compose service name for your DB   [postgres]
COMPOSE_SERVICES="postgres redis adminer"   # services db-shared-up.sh brings up        [postgres redis adminer]
BASE_BRANCH="development"                   # PR base = the integration branch          [development]
                                            #   (dev-based flow; hotfixes PR to main manually, outside the harness)
INTEGRATION_BRANCH="development"            # integration / auto-deploy branch          [development]
BRANCH_PREFIX="feat/"                       # feature-branch prefix                     [feat/]
TEST_PATHS=""                               # space-separated path globs that count as test files (e.g. "tests/ *.test.* e2e/");
                                            #   ship-feature's test-only fast-path skips browser QC when a re-entry touches only these
GENERATED_MERGE_PATHS=""                    # space-separated GENERATED files (e.g. an openapi contract) that must never be
                                            #   hand-merged: lanes get a keep-ours merge driver for them and hooks/regen.sh
                                            #   regenerates them after every merge (conflicts on generated files are pure waste)
MIGRATIONS_DIR=""                           # dir of NUMBERED migrations (NNN_*.ext), if your stack has one; lane-sync-dev
                                            #   then fails fast when a feature's new migration number already exists on the
                                            #   integration branch (two lanes picking the same number merges silently otherwise)
QC_BOOT_ENV=""                              # env pairs `lane-up.sh --qc` applies (set-if-unset) for QC/e2e boots, e.g.
                                            #   "MOCK_MODE=true RATE_LIMIT=off" — stub out paid/LLM backends so QC is
                                            #   deterministic and free; leave empty if your stack needs no special QC env
QA_TOKEN_KEY=""                             # localStorage key names lane-qa-login.cjs plants after an API login
QA_REFRESH_KEY=""                           #   [access_token / refresh_token]; QA_ORG_KEY empty = skip the org lookup
QA_ORG_KEY=""
# OpenHands DEV engine sandbox: an image with this app's build/test toolchain
# (e.g. maven:3.9-eclipse-temurin-21, node:22-bookworm, python:3.12-bookworm).
OPENHANDS_BASE_IMAGE="${OPENHANDS_BASE_IMAGE:-debian:bookworm-slim}"
OPENHANDS_EXTRA_PACKAGES="${OPENHANDS_EXTRA_PACKAGES:-}"   # extra apt/apk packages, space-separated
IMPL_AGENTS="1"                             # max impl-worker agents coding ONE feature in parallel at Stage 1 [1]
                                            #   1 = off (the main session codes every task itself). >1 = tasks.md task groups
                                            #   (`· nhóm:A`) touching disjoint files are coded concurrently, each in its own
                                            #   git worktree; gates/e2e/QC still run once on the merged branch. Each worker is a
                                            #   full Claude session — mind RAM/usage (2–3 is plenty)
