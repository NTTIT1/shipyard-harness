# profiles/<your-project>/integrations.env — optional org integrations (sourced by _common.sh).
# Each integration is OFF by default; a disabled integration's pipeline stage is skipped
# entirely, so a GitHub-only project runs implement -> ci-gate -> PR -> integrate ->
# local-QC -> senior-gate -> push without any of them. Turn one on by setting *_ENABLED=1
# and filling its fields (the /harness-adapt skill can do this for you).

TRACKER_ENABLED=0          # 1 = file a tracker ticket after a dev push
TRACKER_PROVIDER=""        # e.g. jira | linear | github-issues | <yours>  (generate the provider agent via /harness-adapt)
TRACKER_URL=""             # tracker project/issues URL
TRACKER_PROJECT=""         # project/board name
TRACKER_STATUS=""          # column/status to file under (e.g. Started / In Progress)
TRACKER_ASSIGNEE=""        # default assignee
TRACKER_MCP=""             # name of the Playwright MCP server scoped to the tracker

# Bugs found by the TEST step (bin/bug-log.py). bugs.csv is always written next to the test report
# (import it into Jira / Google Sheets / Excel); set a tracker to file each bug automatically, once.
BUG_TRACKER="none"         # none | github | jira | sheets
BUG_GITHUB_REPO=""         # github: owner/repo for the issues (empty = the lane repo)
JIRA_URL=""                # jira: https://<site>.atlassian.net
JIRA_PROJECT=""            # jira: project key, e.g. HRM
JIRA_ISSUE_TYPE="Bug"
# jira: JIRA_EMAIL and JIRA_API_TOKEN go in config/secrets.env, never here.
BUG_SHEET_WEBHOOK=""       # sheets: URL of a Google Apps Script web app that appends one row per bug

DEV_QC_ENABLED=0           # 1 = browser-QC a deployed dev site after push
DEV_SITE_URL=""            # e.g. https://dev.example.com
DEV_QC_MCP=""              # name of the Playwright MCP server scoped to the dev site

CI_WAIT_ENABLED=0          # 1 = wait for a deploy status before dev-QC
CI_PROVIDER="github-status"
CI_REPO=""                 # owner/repo whose commit status reports the deploy
CI_DEPLOY_CONTEXT=""       # the status context name to wait for (e.g. "ci/circleci: deploy-dev")
# Optional extra: a CI API token (CIRCLE_CI_TOKEN in config/secrets.env) enables
# bin/ci-job.sh — lanes can then read failing CI tests, re-run a flaky workflow,
# or cancel a hung one themselves. Project slug defaults to gh/$CI_REPO;
# set CIRCLE_PROJECT_SLUG to override (e.g. bitbucket VCS).

# Shipyard Platform role pipeline (PM → BA → ARCH → DESIGN → TESTCASE → DEV → SECURITY → TEST with human gates).
# Set to the platform project id (proj_…) to enable it for this profile; empty = classic /ship-feature.
PLATFORM_PROJECT_ID=""
